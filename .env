# ---------------------------------------------------------------------------
# Carpoolio — self-hosted stack configuration
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit the filled-in .env.
#
# Generate the secrets with:  node scripts/generate-secrets.mjs
# ---------------------------------------------------------------------------

## ---- Secrets you MUST generate --------------------------------------------

# Postgres superuser password + password for all Supabase service roles.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Shared JWT signing secret (>= 32 chars). ANON_KEY and SERVICE_ROLE_KEY MUST
# be signed with exactly this value or every API call returns 401.
#   openssl rand -hex 32
JWT_SECRET=

# Public API key (role: anon). JWT signed with JWT_SECRET.
# Safe to ship to the browser. Generated by scripts/generate-secrets.mjs.
ANON_KEY=

# Admin API key (role: service_role). JWT signed with JWT_SECRET.
# SERVER-SIDE ONLY — bypasses RLS. Never expose to the browser.
SERVICE_ROLE_KEY=

# Realtime encryption/session secrets.
#   openssl rand -hex 16   (must be exactly 16 chars for REALTIME_ENC_KEY)
REALTIME_ENC_KEY=
#   openssl rand -hex 32
REALTIME_SECRET_KEY_BASE=

## ---- Public URLs / routing -------------------------------------------------

# Public hostnames served through Cloudflare Tunnel.
FRONTEND_HOST=carpoolio.example.com
API_HOST=api.carpoolio.example.com

# Public URL of the self-hosted Supabase API. Baked into the frontend bundle
# at build time and used as GoTrue's external URL.
SUPABASE_PUBLIC_URL=https://api.carpoolio.example.com

# Public URL of the app itself (auth redirects, share links).
SITE_URL=https://carpoolio.example.com

# Extra allowed auth redirect targets (comma separated).
ADDITIONAL_REDIRECT_URLS=https://carpoolio.example.com/**,http://localhost:8080/**

# Origins allowed to call the Supabase API (CORS, enforced by Kong).
CORS_ALLOWED_ORIGINS=https://carpoolio.example.com,http://localhost:8080

## ---- Local ports -----------------------------------------------------------

# Port nginx listens on, on your Mac. Point Cloudflare Tunnel here.
HTTP_PORT=8080
# Postgres, bound to 127.0.0.1 only.
POSTGRES_PORT=5432
POSTGRES_DB=postgres

## ---- Auth behaviour --------------------------------------------------------

DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true

